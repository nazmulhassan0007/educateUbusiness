# Environment variables for educateU Business.
# Copy to .env.local and fill in. Never commit real values.
# On Vercel, add each one to the environment the site runs on (Production
# and/or Preview). NEXT_PUBLIC_* values are built into the page code, so
# changing one needs a redeploy.

# ── Stripe (required) ─────────────────────────────────────────────────────
# Test keys (sk_test_/pk_test_) everywhere except production. Prefer a
# restricted key (rk_) with write access to Checkout Sessions, Coupons and
# PaymentIntents over a full secret key.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Locally: the secret printed by `npx stripe listen`.
# On Vercel: the signing secret of the webhook endpoint in the Stripe
# Dashboard, subscribed to checkout.session.completed,
# checkout.session.async_payment_succeeded and checkout.session.async_payment_failed.
STRIPE_WEBHOOK_SECRET=

# ── Resend: contact form and newsletter (required) ────────────────────────
RESEND_API_KEY=
# Team inbox that receives contact enquiries and new-subscriber notices.
RESEND_CONTACT_TO_EMAIL=
# The Resend audience the newsletter list lives in.
RESEND_AUDIENCE_ID=

# ── Recommended (have fallbacks, but set them explicitly) ─────────────────
# Sender for emails. Its domain must be verified in the same Resend account
# as RESEND_API_KEY. Default: no-reply@mail.educateu.com
RESEND_FROM_EMAIL=
# A random value of its own (e.g. `openssl rand -base64 32`). Falls back to
# RESEND_API_KEY, and changing whichever is used breaks every unsubscribe
# link already sent.
NEWSLETTER_UNSUBSCRIBE_SECRET=
# Public site address, used for links and the logo in emails.
# Default: the address the request came in on (e.g. localhost).
NEXT_PUBLIC_BASE_URL=
# Backend for courses, auth and checkout. Default: http://3.8.193.16
COURSES_API_URL=http://3.8.193.16
# CMS. Default: https://pen-websites-cms.vercel.app
API_URL=https://pen-websites-cms.vercel.app

# Set automatically, don't add: NODE_ENV (Next.js), NEXT_PUBLIC_VERCEL_ENV (Vercel).
